APP_NAME=Portafolio Riesgo API
APP_VERSION=0.1.0
APP_ENV=dev
DEBUG=true

API_V1_PREFIX=/api/v1

DEFAULT_START_DATE=2021-01-01
DEFAULT_END_DATE=2026-12-31
GLOBAL_BENCHMARK=ACWI
DEFAULT_BASE_CURRENCY=USD

RF_TICKER_USD=^IRX
RF_TICKER_EUR=^GDBR10
RF_TICKER_COP_PROXY=^IRX

FRED_API_KEY=

FRONTEND_BASE_URL=http://localhost:8501
YAHOO_TIMEOUT_SECONDS=20
MACRO_TIMEOUT_SECONDS=20
EXTERNAL_API_TIMEOUT_SECONDS=20

INTERNAL_API_KEY=

ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

MIN_OBS_VAR=60
MIN_OBS_CAPM=60
MIN_OBS_PORTFOLIO=60
# Chatbot experto con IA real
# Por defecto usa motor experto local sin llamadas externas.
LLM_PROVIDER=local
LLM_MODEL=local-expert
LLM_API_KEY=
LLM_BASE_URL=
