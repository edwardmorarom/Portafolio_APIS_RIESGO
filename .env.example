# =========================
# Backend FastAPI
# =========================

APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./data/portafolio_riesgo.db
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
INTERNAL_API_KEY=change_me

# APIs externas opcionales
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=

# Chatbot IA opcional
# Para Groq: LLM_PROVIDER=groq, GROQ_API_KEY=..., LLM_MODEL=llama-3.1-8b-instant
# Para Gemini: LLM_PROVIDER=gemini, LLM_API_KEY=..., LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=local
LLM_MODEL=local-expert
LLM_API_KEY=
LLM_BASE_URL=
GROQ_API_KEY=
GEMINI_API_KEY=

# =========================
# Frontend Streamlit
# =========================

BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_API_PREFIX=/api/v1
BACKEND_TIMEOUT_SECONDS=30
